feature ss01 {
featureNames {
  name "Baybayin";
};
# ==========================================
# LOOKUP 1: Normalize Latin (Strip Diacritics)
# ==========================================
lookup StripDiacritics {
    # --- Uppercase ---
    sub [Aacute Abreve Abreveacute Abrevedotbelow Abrevegrave Abrevehookabove Abrevetilde Acaron Acircumflex Acircumflexacute Acircumflexdotbelow Acircumflexgrave Acircumflexhookabove Acircumflextilde Adieresis Adotbelow Agrave Ahookabove Amacron Aogonek Aring Aringacute Atilde] by A;
    sub [Cacute Ccaron Ccircumflex Cdotaccent] by C;
    sub [Dcaron Dcroat Eth] by D;
    sub [Eacute Ebreve Ecaron Ecircumflex Ecircumflexacute Ecircumflexdotbelow Ecircumflexgrave Ecircumflexhookabove Ecircumflextilde Edieresis Edotaccent Edotbelow Egrave Ehookabove Emacron Eogonek Etilde AEacute] by E;
    sub [Gcaron Gcircumflex Gcommaaccent Gdotaccent Gmacron] by G;
    sub [Hbar Hcircumflex] by H;
    sub [IJ Iacute Ibreve Icaron Icircumflex Idieresis Idotaccent Idotbelow Igrave Ihookabove Imacron Iogonek Itilde] by I;
    sub [Jacute Jcircumflex] by J;
    sub Kcommaaccent by K;
    sub [Lacute Lcaron Lcommaaccent Ldot Lslash Lcommaaccent.loclMAH] by L;
    sub [Nacute Ncaron Ncommaaccent Ndotaccent Ncommaaccent.loclMAH] by N;
    sub [Oacute Obreve Ocaron Ocircumflex Ocircumflexacute Ocircumflexdotbelow Ocircumflexgrave Ocircumflexhookabove Ocircumflextilde Odieresis Odotbelow Ograve Ohookabove Ohorn Ohornacute Ohorndotbelow Ohorngrave Ohornhookabove Ohorntilde Ohungarumlaut Omacron Oogonek Oslash Oslashacute Otilde] by O;
    sub [Racute Rcaron Rcommaaccent] by R;
    sub [Sacute Scaron Scedilla Scircumflex Scommaaccent] by S;
    sub [Tbar Tcaron Tcedilla Tcommaaccent] by T;
    sub [Uacute Ubreve Ucaron Ucircumflex Udieresis Udotbelow Ugrave Uhookabove Uhorn Uhornacute Uhorndotbelow Uhorngrave Uhornhookabove Uhorntilde Uhungarumlaut Umacron Uogonek Uring Utilde OE] by U;
    sub [Wacute Wcircumflex Wdieresis Wgrave] by W;
    sub [Yacute Ycircumflex Ydieresis Ydotbelow Ygrave Yhookabove Ymacron Ytilde] by Y;
    sub [Zacute Zcaron Zdotaccent] by Z;

    # --- Lowercase ---
    sub [aacute abreve abreveacute abrevedotbelow abrevegrave abrevehookabove abrevetilde acaron acircumflex acircumflexacute acircumflexdotbelow acircumflexgrave acircumflexhookabove acircumflextilde adieresis adotbelow agrave ahookabove amacron aogonek aring aringacute atilde] by a;
    sub [cacute ccaron ccircumflex cdotaccent] by c;
    sub [dcaron dcroat] by d;
    sub [eacute ebreve ecaron ecircumflex ecircumflexacute ecircumflexdotbelow ecircumflexgrave ecircumflexhookabove ecircumflextilde edieresis edotaccent edotbelow egrave ehookabove emacron eogonek etilde schwa aeacute] by e;
    sub [gbreve gcaron gcircumflex gcommaaccent gdotaccent gmacron] by g;
    sub [hbar hcircumflex] by h;
    sub [iacute ibreve icaron icircumflex idieresis idotaccent idotbelow igrave ihookabove imacron iogonek itilde ij] by i;
    sub [jacute jcircumflex] by j;
    sub kcommaaccent by k;
    sub [lacute lcaron lcommaaccent ldot lslash lcommaaccent.loclMAH] by l;
    sub [nacute napostrophe ncaron ncommaaccent ndotaccent ncommaaccent.loclMAH] by n;
    sub [oacute obreve ocaron ocircumflex ocircumflexacute ocircumflexdotbelow ocircumflexgrave ocircumflexhookabove ocircumflextilde odieresis odotbelow ograve ohookabove ohorn ohornacute ohorndotbelow ohorngrave ohornhookabove ohorntilde ohungarumlaut omacron oogonek oslash oslashacute otilde] by o;
    sub [racute rcaron rcommaaccent] by r;
    sub [sacute scaron scedilla scircumflex scommaaccent] by s;
    sub [tbar tcaron tcedilla tcommaaccent] by t;
    sub [uacute ubreve ucaron ucircumflex udieresis udotbelow ugrave uhookabove uhorn uhornacute uhorndotbelow uhorngrave uhornhookabove uhorntilde uhungarumlaut umacron uogonek uring utilde oe] by u;
    sub [wacute wcircumflex wdieresis wgrave] by w;
    sub [yacute ycircumflex ydieresis ydotbelow ygrave yhookabove ymacron ytilde] by y;
    sub [zacute zcaron zdotaccent] by z;
} StripDiacritics;

# ==========================================
# LOOKUP 2: Multi-Character Syllables (Ligatures)
# ==========================================
lookup BaybayinLigatures {
    # --- 3-Character Sequences ---
    sub [n N] [g G] [a A] by n_g_a.ss01;
    sub [n N] [g G] [e E] by n_g_e.ss01;
    sub [n N] [g G] [i I] by n_g_i.ss01;
    sub [n N] [g G] [o O] by n_g_o.ss01;
    sub [n N] [g G] [u U] by n_g_u.ss01;
    sub [m M] [g G] [a A] by m_g_a.ss01;

    # --- 2-Character Sequences ---
    sub [b B] [a A] by b_a.ss01; sub [b B] [e E] by b_e.ss01; sub [b B] [i I] by b_i.ss01; sub [b B] [o O] by b_o.ss01; sub [b B] [u U] by b_u.ss01;
    sub [c C] [a A] by c_a.ss01; sub [c C] [e E] by c_e.ss01; sub [c C] [i I] by c_i.ss01; sub [c C] [o O] by c_o.ss01; sub [c C] [u U] by c_u.ss01;
    sub [d D] [a A] by d_a.ss01; sub [d D] [e E] by d_e.ss01; sub [d D] [i I] by d_i.ss01; sub [d D] [o O] by d_o.ss01; sub [d D] [u U] by d_u.ss01;
    sub [f F] [a A] by f_a.ss01; sub [f F] [e E] by f_e.ss01; sub [f F] [i I] by f_i.ss01; sub [f F] [o O] by f_o.ss01; sub [f F] [u U] by f_u.ss01;
    sub [g G] [a A] by g_a.ss01; sub [g G] [e E] by g_e.ss01; sub [g G] [i I] by g_i.ss01; sub [g G] [o O] by g_o.ss01; sub [g G] [u U] by g_u.ss01;
    sub [h H] [a A] by h_a.ss01; sub [h H] [e E] by h_e.ss01; sub [h H] [i I] by h_i.ss01; sub [h H] [o O] by h_o.ss01; sub [h H] [u U] by h_u.ss01;
    sub [j J] [a A] by j_a.ss01; sub [j J] [e E] by j_e.ss01; sub [j J] [i I] by j_i.ss01; sub [j J] [o O] by j_o.ss01; sub [j J] [u U] by j_u.ss01;
    sub [k K] [a A] by k_a.ss01; sub [k K] [e E] by k_e.ss01; sub [k K] [i I] by k_i.ss01; sub [k K] [o O] by k_o.ss01; sub [k K] [u U] by k_u.ss01;
    sub [l L] [a A] by l_a.ss01; sub [l L] [e E] by l_e.ss01; sub [l L] [i I] by l_i.ss01; sub [l L] [o O] by l_o.ss01; sub [l L] [u U] by l_u.ss01;
    sub [m M] [a A] by m_a.ss01; sub [m M] [e E] by m_e.ss01; sub [m M] [i I] by m_i.ss01; sub [m M] [o O] by m_o.ss01; sub [m M] [u U] by m_u.ss01;
    sub [n N] [a A] by n_a.ss01; sub [n N] [e E] by n_e.ss01; sub [n N] [i I] by n_i.ss01; sub [n N] [o O] by n_o.ss01; sub [n N] [u U] by n_u.ss01;
    sub [p P] [a A] by p_a.ss01; sub [p P] [e E] by p_e.ss01; sub [p P] [i I] by p_i.ss01; sub [p P] [o O] by p_o.ss01; sub [p P] [u U] by p_u.ss01;
    sub [q Q] [a A] by q_a.ss01; sub [q Q] [e E] by q_e.ss01; sub [q Q] [i I] by q_i.ss01; sub [q Q] [o O] by q_o.ss01; sub [q Q] [u U] by q_u.ss01;
    sub [r R] [a A] by r_a.ss01; sub [r R] [e E] by r_e.ss01; sub [r R] [i I] by r_i.ss01; sub [r R] [o O] by r_o.ss01; sub [r R] [u U] by r_u.ss01;
    sub [s S] [a A] by s_a.ss01; sub [s S] [e E] by s_e.ss01; sub [s S] [i I] by s_i.ss01; sub [s S] [o O] by s_o.ss01; sub [s S] [u U] by s_u.ss01;
    sub [t T] [a A] by t_a.ss01; sub [t T] [e E] by t_e.ss01; sub [t T] [i I] by t_i.ss01; sub [t T] [o O] by t_o.ss01; sub [t T] [u U] by t_u.ss01;
    sub [v V] [a A] by v_a.ss01; sub [v V] [e E] by v_e.ss01; sub [v V] [i I] by v_i.ss01; sub [v V] [o O] by v_o.ss01; sub [v V] [u U] by v_u.ss01;
    sub [w W] [a A] by w_a.ss01; sub [w W] [e E] by w_e.ss01; sub [w W] [i I] by w_i.ss01; sub [w W] [o O] by w_o.ss01; sub [w W] [u U] by w_u.ss01;
    sub [x X] [a A] by x_a.ss01; sub [x X] [e E] by x_e.ss01; sub [x X] [i I] by x_i.ss01; sub [x X] [o O] by x_o.ss01; sub [x X] [u U] by x_u.ss01;
    sub [y Y] [a A] by y_a.ss01; sub [y Y] [e E] by y_e.ss01; sub [y Y] [i I] by y_i.ss01; sub [y Y] [o O] by y_o.ss01; sub [y Y] [u U] by y_u.ss01;
    sub [z Z] [a A] by z_a.ss01; sub [z Z] [e E] by z_e.ss01; sub [z Z] [i I] by z_i.ss01; sub [z Z] [o O] by z_o.ss01; sub [z Z] [u U] by z_u.ss01;

    # --- 2-Character Fallbacks (NG Base) ---
    sub [n N] [g G] by n_g.ss01;

    # --- Contextual & Special Latin Triggers ---
    sub [ntilde Ntilde] [a A] by ntilde_a.ss01;
    sub [ccedilla Ccedilla] [a A] by ccedilla_a.ss01;
    sub [ccedilla Ccedilla] [e E] by ccedilla_e.ss01;
    sub [ccedilla Ccedilla] [i I] by ccedilla_i.ss01;
    sub [ccedilla Ccedilla] [o O] by ccedilla_o.ss01;
    sub [ccedilla Ccedilla] [u U] by ccedilla_u.ss01;
} BaybayinLigatures;

# ==========================================
# LOOKUP 3: Single Base Characters
# ==========================================
lookup BaybayinBaseFallbacks {
    sub [a A] by a.ss01; sub [b B] by b.ss01; sub [c C] by c.ss01;
    sub [d D] by d.ss01; sub [e E] by e.ss01; sub [f F] by f.ss01;
    sub [g G] by g.ss01; sub [h H] by h.ss01; sub [i I] by i.ss01;
    sub [j J] by j.ss01; sub [k K] by k.ss01; sub [l L] by l.ss01;
    sub [m M] by m.ss01; sub [n N] by n.ss01; sub [o O] by o.ss01;
    sub [p P] by p.ss01; sub [q Q] by q.ss01; sub [r R] by r.ss01;
    sub [s S] by s.ss01; sub [t T] by t.ss01; sub [u U] by u.ss01;
    sub [v V] by v.ss01; sub [w W] by w.ss01; sub [x X] by x.ss01;
    sub [y Y] by y.ss01; sub [z Z] by z.ss01;

    # --- Special Character Fallbacks ---
    sub [ntilde Ntilde] by ntilde.ss01;
    sub [ccedilla Ccedilla] by ccedilla.ss01;

    # --- Punctuation ---
    sub period by period.ss01;
    sub comma by comma.ss01;
    sub exclam by exclam.ss01;
    sub question by question.ss01;
} BaybayinBaseFallbacks;

# ==========================================
# LOOKUP 4: Contextual Adjustments (Pamudpod & Edge Cases)
# ==========================================
lookup BaybayinContextual {
    # --- Contextual Ñ/Nya combinations from direct typing ---
    sub ntilde.ss01 a.ss01 by ntilde_a.ss01;
    sub ntilde.ss01 e.ss01 by ntilde_e.ss01;
    sub ntilde.ss01 i.ss01 by ntilde_i.ss01;
    sub ntilde.ss01 o.ss01 by ntilde_o.ss01;
    sub ntilde.ss01 u.ss01 by ntilde_u.ss01;
} BaybayinContextual;

    # --- Terminating Pamudpod Trigger ---
    # Trigger when followed by punctuation classes.
    sub @ViramaConsonants_ss01' @Punctuation_ss01 by @Pamudpod_ss01;

} ss01;

feature cpsp {
# automatic
pos @Uppercase <5 0 10 0>;

} cpsp;
